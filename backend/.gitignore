# ============================================================
#  ORYN Backend – .gitignore
# ============================================================

# Dependencies
node_modules/

# Environment / secrets
.env
.env.local
.env.*.local

# File uploads (user-generated content)
uploads/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build output
dist/
build/

# OS-generated
.DS_Store
Thumbs.db

# Editor / IDE
.vscode/
.idea/
*.swp
*.swo

# Coverage reports
coverage/
